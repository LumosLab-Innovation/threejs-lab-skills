{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/threejs-lab-router.js\"; exit 0",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\threejs-lab-router.js\" }",
            "timeout": 5,
            "statusMessage": "Routing Three.js lab skill..."
          }
        ]
      }
    ]
  }
}
